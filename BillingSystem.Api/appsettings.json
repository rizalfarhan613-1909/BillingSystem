{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=BillingSystemDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "Queues": {
    "ScanRequests": "billing-scan-requests",
    "InvoiceJobs": "billing-invoice-jobs",
    "InvoiceJobsPoison": "billing-invoice-jobs-poison",
    "MaxDequeueCount": 5,
    "MaxConcurrency": 8,
    "VisibilityTimeoutSeconds": 120,
    "MessageTtlDays": 7
  },
  "Billing": {
    "BusinessTimeZone": "Asia/Jakarta",
    "ScanIntervalMinutes": 60,
    "PaymentTermDays": 14,
    "OverdueGraceDays": 30,
    "AllowSimulatedDate": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}