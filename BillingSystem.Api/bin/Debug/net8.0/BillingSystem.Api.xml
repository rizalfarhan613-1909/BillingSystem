        <member name="M:BillingSystem.Api.Controllers.BillingController.TriggerAsync(BillingSystem.Api.Controllers.TriggerBillingRequest,System.Threading.CancellationToken)">
            <summary>
            Memicu proses penagihan (billing run) secara manual.
            </summary>
            <param name="request">Request berisi tanggal simulasi (optional, hanya diizinkan jika AllowSimulatedDate=true).</param>
